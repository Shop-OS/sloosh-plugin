{
  "tools": [
    {
      "name": "get_connection",
      "description": "Check the Sloosh connection, spending status and the daily allowance left. Call once at the start of a conversation.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_guide",
      "description": "Read a Sloosh guide by id: connection, spending, assets, generation, spaces, recovery, release-status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "list_models",
      "description": "List generation models for a mode (image_gen, video_gen, video_edit, video_extend) with their limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          }
        },
        "required": [
          "mode"
        ]
      }
    },
    {
      "name": "list_assets",
      "description": "List assets already in the Sloosh workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "query": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "import_asset",
      "description": "Import an image, video or audio file from any public HTTPS URL, including a signed URL that has not expired, and register it in the workspace library.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "name"
        ]
      }
    },
    {
      "name": "view_asset",
      "description": "Look at an image asset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ]
      }
    },
    {
      "name": "get_asset",
      "description": "Get an asset and its current URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ]
      }
    },
    {
      "name": "list_spaces",
      "description": "Search published Spaces.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "quote_generation",
      "description": "Quote image generation, video generation or video editing. Uses owned asset IDs and returns a single-use quote. Does not start work or debit credits. When warning is set, tell the user before they approve. enhancePrompt (default on) rewrites the prompt at generation without showing it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "image_gen",
              "video_gen",
              "video_edit",
              "video_extend"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "modelConfig": {
            "type": "object",
            "properties": {
              "modelName": {
                "type": "string"
              },
              "aspectRatio": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "quality": {
                "type": "string"
              },
              "duration": {
                "type": "number"
              },
              "generateAudio": {
                "type": "boolean"
              },
              "seed": {
                "type": "integer"
              }
            },
            "required": [
              "modelName"
            ]
          },
          "enhancePrompt": {
            "type": "boolean"
          },
          "generationCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "uploadedAssets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "workspace",
                    "generated"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "image",
                    "video"
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "reference",
                    "start_frame",
                    "end_frame"
                  ]
                }
              },
              "required": [
                "kind",
                "id",
                "url",
                "type"
              ]
            },
            "maxItems": 20
          }
        },
        "required": [
          "prompt",
          "modelConfig"
        ]
      }
    },
    {
      "name": "generate",
      "description": "Start a paid generation for a quote. Needs quoteId, a stable idempotencyKey and confirmed=true after the user approves the quote.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "quoteId",
          "idempotencyKey",
          "confirmed"
        ]
      }
    },
    {
      "name": "show_generation",
      "description": "Show a result card for up to 8 operation ids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "operationIds"
        ]
      }
    },
    {
      "name": "get_generation",
      "description": "Get the status and outputs of a generation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string"
          }
        },
        "required": [
          "operationId"
        ]
      }
    }
  ]
}
